---
import "../styles/global.css";
import Container from "../components/common/Container";
import LandingHeader from "../components/landing/LandingHeader";
import LandingActions from "../components/landing/LandingActions";
import RolesSection from "../components/landing/RolesSection";
import BrandLogo from "../components/common/BrandLogo";
import { Badge } from "../components/ui/badge";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- SVG Icon as Tab and Default Icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Undercover | Social Deduction Word Game</title>
    <meta
      name="description"
      content="A real-time, zero-login social deduction word game for groups and calls. Civilians vs Undercover vs Mr. White. Built with neo-brutalism design."
    />
    <meta property="og:title" content="Undercover — Social Deduction Word Game" />
    <meta property="og:description" content="Find the impostor before they find you. Instant browser play for 4–20 players." />
    <meta property="og:image" content="https://undercover.aarab.me/og-image.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Undercover | Social Deduction Word Game" />
    <meta name="twitter:description" content="Find the impostor before they find you. Instant browser play for 4–20 players." />
    <meta name="twitter:image" content="https://undercover.aarab.me/og-image.png" />

    <!-- Google Fonts: Archivo Black, Public Sans, IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;700&family=Public+Sans:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-ink bg-dossier-grid min-h-screen flex flex-col justify-between font-para selection:bg-amber-tint selection:text-ink">
    <!-- Top Header -->
    <div class="border-b-[3px] border-black bg-paper/95 backdrop-blur-xs sticky top-0 z-40">
      <Container id="header-container" className="py-3.5">
        <LandingHeader client:load />
      </Container>
    </div>

    <!-- Main Content Area -->
    <main class="my-auto py-10 sm:py-16 space-y-16 sm:space-y-24">
      <!-- Hero Section -->
      <Container id="hero-section" className="text-center flex flex-col items-center">
        <!-- Eyebrow Badge -->
        <div class="mb-6">
          <Badge
            variant="primary"
            className="px-3.5 py-1 text-xs font-black tracking-wider uppercase border-2 border-black shadow-brutal-sm inline-flex items-center gap-2 bg-amber-base text-ink"
          >
            <span>🕵️</span> NO LOGIN • REAL-TIME • ZERO FRIENDSHIPS PRESERVED
          </Badge>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-ink max-w-4xl leading-[1.04] mb-6 font-heading">
          One of you is lying. <br class="hidden sm:inline" />
          <span class="bg-amber-base px-2.5 py-0.5 border-[3px] border-black shadow-brutal inline-block my-1.5 sm:my-0 rotate-[-1deg] text-ink">
            Find the Impostor
          </span>{" "}
          before you lose all respect for your friends.
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-xl font-medium text-ink-muted max-w-2xl mb-10 leading-relaxed">
          Gather your friends in person or on a call. Everyone gets a secret word, except one person with a slightly different word, and one person who is completely winging it with nothing.
        </p>

        <!-- Main Action Buttons: Create Room, Join Room & Rules Dialog -->
        <LandingActions client:load />
      </Container>

      <!-- Roles & How to Play Section -->
      <Container id="roles-section">
        <RolesSection client:load />
      </Container>
    </main>

    <!-- Footer -->
    <footer class="border-t-[3px] border-black bg-paper py-8 mt-16">
        <Container
          id="footer-container"
          className="flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left"
        >
          <div class="flex items-center gap-3">
            <BrandLogo size="sm" showTagline={true} />
          </div>

          <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-bold text-ink-muted">
            <a
              href="https://www.aarab.me/license"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded-base border-2 border-black bg-amber-tint shadow-brutal-sm no-underline text-ink hover:bg-amber-base transition-colors"
            >
              License
            </a>

            <a
              href="https://www.aarab.me/privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded-base border-2 border-black bg-sky-tint shadow-brutal-sm no-underline text-ink hover:bg-sky-base transition-colors"
            >
              Privacy Policy
            </a>

            <a
              href="https://www.aarab.me/terms"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded-base border-2 border-black bg-lime-tint shadow-brutal-sm no-underline text-ink hover:bg-lime-base transition-colors"
            >
              Terms
            </a>
          </div>

          <div class="text-xs font-black uppercase tracking-wider text-ink-muted font-mono">
            Made with • ❤️ •{" "}
            <a
              href="https://aarab.me"
              class="no-underline text-inherit hover:underline"
            >
              aarabii
            </a>
          </div>
        </Container>
    </footer>
  </body>
</html>
