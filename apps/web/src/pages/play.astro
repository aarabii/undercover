---
import "../styles/global.css";
import Container from "../components/common/Container";
import BrandLogo from "../components/common/BrandLogo";
import GameApp from "../components/GameApp";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, follow" />
    <title>Play Undercover — Real-Time Deduction</title>
    <meta property="og:title" content="Join Undercover — Real-Time Word Deduction" />
    <meta property="og:description" content="Enter room to play Undercover with your group in real-time. No sign-up required." />
    <meta property="og:image" content="https://undercover.aarab.me/og-image.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Join Undercover — Real-Time Word Deduction" />
    <meta name="twitter:description" content="Enter room to play Undercover with your group in real-time. No sign-up required." />
    <meta name="twitter:image" content="https://undercover.aarab.me/og-image.png" />
  </head>
  <body class="bg-[#fdfbf7] text-[#121212] min-h-screen flex flex-col justify-between font-para selection:bg-yellow-300 selection:text-black">
    <header class="border-b-[3px] border-black bg-white">
      <Container id="play-header" className="py-3 flex justify-between items-center">
        <a href="/" class="hover:opacity-90 transition-opacity">
          <BrandLogo size="sm" showTagline={false} />
        </a>
        <div class="flex items-center gap-3">
          <a
            href="/"
            class="text-xs font-black uppercase tracking-wider px-3 py-1.5 rounded-base border-2 border-black bg-white shadow-brutal-sm hover:bg-yellow-200 transition-colors"
          >
            Back to Safety
          </a>
        </div>
      </Container>
    </header>

    <main class="my-auto py-4">
      <Container id="play-main">
        <GameApp client:only="react" />
      </Container>
    </main>

    <footer class="border-t-[3px] border-black py-4 bg-white/50 text-center">
        <Container
          id="footer-container"
          className="flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left"
        >
          <div class="flex items-center gap-3">
            <BrandLogo size="sm" showTagline={true} />
          </div>

          <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-bold text-gray-700">
            <a
              href="https://github.com/aarabii/undercover/issues/new?template=bug_report.yml"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded-base border-2 border-black bg-yellow-200 shadow-brutal-sm no-underline text-inherit"
            >
              Report a Bug
            </a>

            <a
              href="https://www.aarab.me/contact"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded-base border-2 border-black bg-sky-200 shadow-brutal-sm no-underline text-inherit"
            >
                Contact Dev
            </a>

            <a
              href="https://github.com/aarabii/undercover/issues/new?template=feature_request.yml"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded-base border-2 border-black bg-lime-200 shadow-brutal-sm no-underline text-inherit"
            >
              Request a Feature
            </a>
          </div>

          <div class="text-xs font-black uppercase tracking-wider text-gray-600 font-mono">
            Made with • ❤️ •{" "}
            <a
              href="https://aarab.me"
              class="no-underline text-inherit"
            >
              aarabii
            </a>
          </div>
        </Container>
    </footer>
  </body>
</html>
