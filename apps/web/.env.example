# Game WebSocket and REST server host (host:port for local dev, or your deployed Worker domain)
PUBLIC_WS_HOST=localhost:8787

# Public web application URL used for canonical metadata, OpenGraph images, and sitemap generation
PUBLIC_SITE_URL=http://localhost:4321

# Cloudflare Turnstile site key (below is Cloudflare's always-pass test key for local dev)
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Optional footer links (leave unset to omit Privacy/Terms links and default author link to GitHub)
# PUBLIC_PRIVACY_URL=https://example.com/privacy
# PUBLIC_TERMS_URL=https://example.com/terms
# PUBLIC_AUTHOR_URL=https://github.com/aarabii
